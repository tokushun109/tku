{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": [
    "after 10pm and before 11pm on Thursday"
  ],
  "prHourlyLimit": 4,
  "prConcurrentLimit": 10,
  "minimumReleaseAge": "3 days",
  "enabledManagers": [
    "npm",
    "gomod",
    "dockerfile",
    "terraform",
    "github-actions",
    "asdf",
    "mise",
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "LambdaのNode.jsメジャーランタイムを検出する",
      "managerFilePatterns": ["infra/opentofu/aws-runtime.tf"],
      "matchStrings": ["runtime\\s*=\\s*\"nodejs(?<currentValue>\\d+)\\.x\""],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "lambda-node",
      "autoReplaceStringTemplate": "runtime       = \"nodejs{{newMajor}}.x\""
    }
  ],
  "packageRules": [
    {
      "description": "majorは手動レビュー",
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "deps:major"
      ],
      "automerge": false,
      "prPriority": -1
    },
    {
      "description": "minor/patchは自動マージ（テスト成功が条件）",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "GitHub Actions は1PRに集約",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Dockerfile ベースイメージ更新",
      "matchManagers": [
        "dockerfile"
      ],
      "groupName": "Docker base images"
    },
    {
      "description": "frontend: コア依存関係",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "frontend/**"
      ],
      "groupName": "frontend: core deps",
      "matchPackageNames": [
        "/^react/",
        "/^next/",
        "/^@next//",
        "/^typescript/"
      ]
    },
    {
      "description": "frontend: その他の依存関係",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "frontend/**"
      ],
      "groupName": "frontend: other deps"
    },
    {
      "description": "backend: コア依存関係",
      "matchManagers": [
        "gomod"
      ],
      "matchFileNames": [
        "backend/**"
      ],
      "groupName": "backend: core deps",
      "matchPackageNames": [
        "github.com/gorilla/mux",
        "gorm.io/gorm",
        "gorm.io/driver/mysql"
      ],
      "postUpdateOptions": [
        "gomodTidy"
      ]
    },
    {
      "description": "backend: その他の依存関係",
      "matchManagers": [
        "gomod"
      ],
      "matchFileNames": [
        "backend/**"
      ],
      "groupName": "backend: other deps",
      "postUpdateOptions": [
        "gomodTidy"
      ]
    },
    {
      "description": "infra: Lambda ビルドツール",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "infra/lambda/**"
      ],
      "groupName": "infra: Lambda build tools",
      "matchPackageNames": [
        "/^esbuild/"
      ]
    },
    {
      "description": "Terraform プロバイダ/モジュール",
      "matchManagers": [
        "terraform"
      ],
      "groupName": "Terraform deps"
    },
    {
      "description": "asdf 言語バージョン管理",
      "matchManagers": [
        "asdf"
      ],
      "groupName": "asdf language versions",
      "matchFileNames": [
        ".tool-versions"
      ]
    },
    {
      "description": "Node.js LTS版のみ対象",
      "matchManagers": ["asdf"],
      "matchDatasources": [
        "node-version"
      ],
      "matchPackageNames": [
        "node",
        "nodejs"
      ],
      "versioning": "node",
      "rangeStrategy": "bump"
    },
    {
      "description": "Goのバージョンを更新",
      "matchDatasources": [
        "golang-version"
      ],
      "matchPackageNames": [
        "golang"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "Goのローカル・Railway・Docker指定をまとめて更新",
      "matchManagers": ["asdf", "mise", "dockerfile"],
      "matchFileNames": [".tool-versions", "backend/mise.toml", "backend/docker/api/Dockerfile"],
      "matchPackageNames": ["go", "golang", "golang/go", "docker.io/library/golang"],
      "groupName": "Go toolchain"
    },
    {
      "description": "Node.jsのローカル・Docker・Lambda指定をまとめて更新",
      "matchManagers": ["asdf", "dockerfile", "custom.regex"],
      "matchFileNames": [".tool-versions", "frontend/docker/Dockerfile", "infra/opentofu/aws-runtime.tf"],
      "matchPackageNames": ["node", "nodejs", "docker.io/library/node"],
      "groupName": "Node.js runtime"
    },
    {
      "description": "Lambdaのパッチ更新はAWS Autoに任せ、メジャー更新だけをPRにする",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["infra/opentofu/aws-runtime.tf"],
      "matchUpdateTypes": ["minor", "patch"],
      "enabled": false
    }
  ]
}
